{
  "name": "@boxkit/sdk",
  "version": "1.0.0",
  "description": "BoxKit 插件开发 SDK：类型定义与运行时辅助",
  "license": "MIT",
  "author": "BoxKit Authors <dev@boxkit.app>",
  "repository": {
    "type": "git",
    "url": "https://github.com/niocoders/boxkit.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/niocoders/boxkit/issues"
  },
  "homepage": "https://github.com/niocoders/boxkit#readme",
  "keywords": [
    "boxkit",
    "plugin",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRACTS.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node src/build.mjs",
    "test": "vitest run --root ../.. packages/sdk/src/contract.test.ts",
    "prepack": "node src/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
